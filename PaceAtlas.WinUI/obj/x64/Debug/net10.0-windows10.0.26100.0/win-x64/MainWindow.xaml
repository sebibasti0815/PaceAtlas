<Window
    x:Class="PaceAtlas.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pace Atlas">
    <Grid Background="#EEF3F8">
        <Grid.Resources>
            <SolidColorBrush x:Key="RunningIntervalBrush" Color="#FFEEED" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#20334C" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:ConnectionId='270'                         Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Info ...">
                        <Image Source="Assets/pace-atlas.png" Width="56" Height="56" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Pace Atlas" FontSize="23" FontWeight="SemiBold" Foreground="White" />
                        <Path x:ConnectionId='274' x:Name="SymptomTrendNeedle" Data="M 8,0 L 15,13 L 10,11 L 10,24 L 6,24 L 6,11 L 1,13 Z"
                              Fill="#D8E2E9" Width="16" Height="24" Stretch="None" HorizontalAlignment="Center">
                            <Path.RenderTransform><RotateTransform x:ConnectionId='275' x:Name="SymptomTrendRotation" CenterX="8" CenterY="12" Angle="90" /></Path.RenderTransform>
                        </Path>
                    </StackPanel>
                    <StackPanel x:ConnectionId='271' x:Name="AppSubtitle" Grid.Column="2" Spacing="1"
                                VerticalAlignment="Center" Margin="8,0,12,0">
                        <TextBlock x:ConnectionId='272' x:Name="MottoQuestion" Text="„Kann ich das, was ich tue, zweimal hintereinander tun?“"
                                   TextWrapping="Wrap" FontFamily="Segoe Script" FontStyle="Italic"
                                   FontSize="14" Foreground="#E3F4F1" />
                        <TextBlock x:ConnectionId='273' x:Name="MottoAnswer" Text="– ist die Antwort „nein“, tue es nicht."
                                   TextWrapping="Wrap" FontSize="13" Foreground="#CEE0EB" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border BorderBrush="#96B9CB" BorderThickness="1" CornerRadius="6" Padding="10,4">
                   <StackPanel Spacing="2">
                    <TextBlock Text="Pacing Timer" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Aktiv (Min.):" Foreground="White" VerticalAlignment="Center" />
                    <NumberBox x:ConnectionId='265' x:Name="PacingActiveMinutes" Width="68" Minimum="2" Maximum="300"
                               SpinButtonPlacementMode="Compact"                                      />
                    <TextBlock Text="Pause (Min.):" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <NumberBox x:ConnectionId='266' x:Name="PacingPauseMinutes" Width="68" Minimum="1" Maximum="120"
                               SpinButtonPlacementMode="Compact"                                      />
                    <Button x:ConnectionId='267' x:Name="PacingStartButton" Width="38" Content="zZz"                          
                            ToolTipService.ToolTip="Pacing starten" />
                    <Button x:ConnectionId='268' x:Name="PacingBreakButton" Width="38" Content="Ⅱ"                          
                            ToolTipService.ToolTip="Pause machen" />
                    <TextBlock x:ConnectionId='269' x:Name="PacingStatus" Width="108" Foreground="White" VerticalAlignment="Center"
                               Text="Timer aus" />
                    </StackPanel>
                   </StackPanel>
                  </Border>
                  <ComboBox x:ConnectionId='264' x:Name="LanguageChoice" Width="93" VerticalAlignment="Center"
                                                                               ToolTipService.ToolTip="Sprache / Language">
                    <ComboBoxItem Tag="de">
                      <Image Source="Assets/flag-de.png" Width="30" Height="19" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="en">
                      <Image Source="Assets/flag-us.png" Width="30" Height="19" />
                    </ComboBoxItem>
                  </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="320" />
                <RowDefinition Height="235" />
            </Grid.RowDefinitions>

            <Border x:ConnectionId='2' x:Name="MainContentBorder" Background="White" CornerRadius="12" Padding="20,14"
                    BorderBrush="#D5E2EA" BorderThickness="1"                                            >
                <TabView x:ConnectionId='19' x:Name="MainTabs" IsAddTabButtonVisible="False" CanReorderTabs="True"
                                                                     
                                                                     >
                  <TabView.Resources>
                    <SolidColorBrush x:Key="TabViewSelectionIndicatorForeground" Color="#167789" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#20334C" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#E2EDF3" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#D6E7EF" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="White" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="White" />
                  </TabView.Resources>
                    <TabViewItem x:ConnectionId='20' x:Name="StateTab" Header="Zustand erfassen" IsClosable="False">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:ConnectionId='243' x:Name="FormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:ConnectionId='248' x:Name="FormContent" Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Zustand erfassen" FontSize="20" FontWeight="SemiBold" />
                        <Border x:ConnectionId='249' x:Name="StateEditingBanner" Visibility="Collapsed" Background="#E2F2F4" CornerRadius="5" Padding="10,6">
                            <TextBlock x:ConnectionId='263' x:Name="StateEditingText" Foreground="#174B57" TextWrapping="Wrap" />
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Zeit:" VerticalAlignment="Center" />
                                <CalendarDatePicker x:ConnectionId='261' x:Name="StateDate" Width="150" PlaceholderText="TT.MM.JJJJ" />
                                <TextBox x:ConnectionId='262' x:Name="StateTime" Width="108" PlaceholderText="HH:mm" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Allgemein:" VerticalAlignment="Center" />
                                <ComboBox x:ConnectionId='260' x:Name="Overall" MinWidth="205" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="PEM:" VerticalAlignment="Center" />
                                <ComboBox x:ConnectionId='259' x:Name="Pem" MinWidth="110" />
                            </StackPanel>
                            <CheckBox x:ConnectionId='257' x:Name="Crash" Grid.Column="3" Content="Crash" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Puls:" VerticalAlignment="Center" />
                                <NumberBox x:ConnectionId='258' x:Name="Pulse" Minimum="0" Maximum="250" Value="0"
                                           Width="100" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Symptome" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:ConnectionId='256' Content="…"                              ToolTipService.ToolTip="Symptome bearbeiten" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,20,0">
                                <Button x:ConnectionId='254' Content="Alle: keine"                        />
                                <Button x:ConnectionId='255' Content="Alle: nicht beurteilt"                              />
                            </StackPanel>
                        </Grid>
                        <Grid x:ConnectionId='250' x:Name="SymptomGrid" ColumnSpacing="12" RowSpacing="4"                                  />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Welches Symptom schränkt dich gerade am meisten ein? (optional)"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:ConnectionId='253' x:Name="MostLimitingSymptom" Width="280" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Schmerzorte" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:ConnectionId='252' Content="…"                                   ToolTipService.ToolTip="Schmerzorte bearbeiten" />
                        </StackPanel>
                        <Grid x:ConnectionId='251' x:Name="PainGrid" ColumnSpacing="8" RowSpacing="2"                                    />
                    </StackPanel>
                </ScrollViewer>
                                <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                        <TextBox x:ConnectionId='244' x:Name="Note" Header="Notiz" PlaceholderText="Was ist dir sonst aufgefallen?"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="74" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:ConnectionId='245' x:Name="StateSaveButton" Content="Zustand speichern"                   
                                    Background="#167789" Foreground="White" />
                            <Button x:ConnectionId='246' Content="Neuer Eintrag"                     />
                            <TextBlock x:ConnectionId='247' x:Name="Status" VerticalAlignment="Center" Foreground="#316073" />
                        </StackPanel>
                </StackPanel>
                </Grid>
                    </TabViewItem>
                    <TabViewItem x:ConnectionId='21' x:Name="IntervalTab" Header="Aktivität und Ruhe" IsClosable="False">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer x:ConnectionId='220' x:Name="IntervalFormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <TextBlock Text="Zeitraum erfassen" FontSize="20" FontWeight="SemiBold" />
                                <Border x:ConnectionId='225' x:Name="IntervalEditingBanner" Visibility="Collapsed" Background="#E2F2F4" CornerRadius="5" Padding="10,6">
                                    <TextBlock x:ConnectionId='242' x:Name="IntervalEditingText" Foreground="#174B57" TextWrapping="Wrap" />
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="Typ:" VerticalAlignment="Center" />
                                        <ComboBox x:ConnectionId='236' x:Name="IntervalKind" MinWidth="145"                                                  />
                                        <TextBlock Text="Beginn:" VerticalAlignment="Center" />
                                        <CalendarDatePicker x:ConnectionId='237' x:Name="IntervalStartDate" Width="150" PlaceholderText="TT.MM.JJJJ" />
                                        <TextBox x:ConnectionId='238' x:Name="IntervalStartTime" Width="108" PlaceholderText="HH:mm" />
                                        <TextBlock Text="Ende:" VerticalAlignment="Center" />
                                        <CalendarDatePicker x:ConnectionId='239' x:Name="IntervalEndDate" Width="150" PlaceholderText="TT.MM.JJJJ" />
                                        <TextBox x:ConnectionId='240' x:Name="IntervalEndTime" Width="108" PlaceholderText="HH:mm" />
                                        <CheckBox x:ConnectionId='241' x:Name="IntervalRunning" Content="Läuft noch – Ende später eintragen"
                                                  VerticalAlignment="Center"                                                                       />
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel x:ConnectionId='226' x:Name="ActivityTemplatePanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Aktivität:" VerticalAlignment="Center" />
                                    <ComboBox x:ConnectionId='234' x:Name="ActivityTemplateChoice" MinWidth="225"                                                   />
                                    <Button x:ConnectionId='235' Content="…"                                       ToolTipService.ToolTip="Aktivitäten verwalten" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock x:ConnectionId='232' x:Name="IntervalDimensionsTitle" Text="Belastungsarten" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Button x:ConnectionId='233' Content="…"                                />
                                </StackPanel>
                                <ItemsControl x:ConnectionId='227' x:Name="IntervalDimensions">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapGrid Orientation="Horizontal" ItemWidth="175" ItemHeight="40" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <ComboBox x:ConnectionId='228' x:Name="IntervalIntensity" Header="Intensität" MinWidth="190" HorizontalAlignment="Left" />
                                <ComboBox x:ConnectionId='229' x:Name="SleepRecovery" Header="Ruhequalität" MinWidth="205" HorizontalAlignment="Left" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Schutzmaßnahmen" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:ConnectionId='231' Content="…"                                       ToolTipService.ToolTip="Schutzmaßnahmen bearbeiten" />
                                </StackPanel>
                                <ItemsControl x:ConnectionId='230' x:Name="IntervalHearingProtection">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapGrid Orientation="Horizontal" ItemWidth="175" ItemHeight="40" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                                <TextBox x:ConnectionId='221' x:Name="IntervalNote" Header="Notiz" PlaceholderText="Was ist dir sonst aufgefallen?"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="74" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:ConnectionId='222' x:Name="IntervalSaveButton" Content="Zeitraum speichern"                            Background="#167789" Foreground="White" />
                                    <Button x:ConnectionId='223' Content="Neuer Eintrag"                             />
                                    <TextBlock x:ConnectionId='224' x:Name="IntervalStatus" VerticalAlignment="Center" Foreground="#316073" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem x:ConnectionId='22' x:Name="MeasureTab" Header="Sofortmaßnahme" IsClosable="False">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ScrollViewer x:ConnectionId='196' x:Name="MeasureFormScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12" Margin="0,8,24,0" MaxWidth="1100" HorizontalAlignment="Left">
                                    <TextBlock Text="Maßnahme erfassen" FontSize="20" FontWeight="SemiBold" />
                                    <Border x:ConnectionId='200' x:Name="MeasureEditingBanner" Visibility="Collapsed" Background="#E2F2F4" CornerRadius="5" Padding="10,6">
                                        <TextBlock x:ConnectionId='219' x:Name="MeasureEditingText" Foreground="#174B57" TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Zeit:" VerticalAlignment="Center" />
                                        <CalendarDatePicker x:ConnectionId='214' x:Name="MeasureDate" Width="150" PlaceholderText="TT.MM.JJJJ" />
                                        <TextBox x:ConnectionId='215' x:Name="MeasureTime" Width="108" PlaceholderText="HH:mm" />
                                        <TextBlock Text="Maßnahme:" VerticalAlignment="Center" />
                                        <ComboBox x:ConnectionId='216' x:Name="MeasureName" Width="190" />
                                        <Button x:ConnectionId='217' Content="…"                              />
                                        <TextBlock Text="Dosis (optional):" VerticalAlignment="Center" />
                                        <TextBox x:ConnectionId='218' x:Name="MeasureDose" Width="150" />
                                    </StackPanel>
                                    <TextBlock Text="Grund / betroffene Symptome (optional)" FontWeight="SemiBold" />
                                    <ItemsControl x:ConnectionId='201' x:Name="MeasureReasons">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="40" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Anderer Grund (optional):" VerticalAlignment="Center" />
                                        <TextBox x:ConnectionId='212' x:Name="MeasureReasonOther" Grid.Column="1" PlaceholderText="Nur wenn kein Symptom passt" />
                                        <CheckBox x:ConnectionId='213' x:Name="MeasureTrack" Grid.Column="2" Content="Verlauf beobachten"                                                                 />
                                    </Grid>
                                    <StackPanel x:ConnectionId='202' x:Name="MeasureTrackingFields" Spacing="10" Visibility="Collapsed">
                                        <TextBox x:ConnectionId='205' x:Name="MeasureGoal" Header="Ziel / Problem" PlaceholderText="Was soll sich verbessern?" />
                                        <TextBox x:ConnectionId='206' x:Name="MeasureBaseline" Header="Ausgangslage (optional)" PlaceholderText="Wie war es vor Beginn der Maßnahme?" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <CalendarDatePicker x:ConnectionId='210' x:Name="MeasureReviewDate" Header="Rückblick geplant am (optional)" Width="220" PlaceholderText="TT.MM.JJJJ" />
                                            <TextBox x:ConnectionId='211' x:Name="MeasureReviewTime" Header="Uhrzeit" Width="110" PlaceholderText="HH:mm" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ComboBox x:ConnectionId='208' x:Name="MeasureProgressStatus" Header="Status" Width="175">
                                                <ComboBoxItem Content="Läuft" Tag="active" />
                                                <ComboBoxItem Content="Pausiert" Tag="paused" />
                                                <ComboBoxItem Content="Abgeschlossen" Tag="completed" />
                                            </ComboBox>
                                            <ComboBox x:ConnectionId='209' x:Name="MeasureOutcome" Header="Beobachtetes Ergebnis" Width="220">
                                                <ComboBoxItem Content="Noch nicht beurteilt" Tag="" />
                                                <ComboBoxItem Content="Deutlich geholfen" Tag="much" />
                                                <ComboBoxItem Content="Etwas geholfen" Tag="some" />
                                                <ComboBoxItem Content="Unverändert" Tag="unchanged" />
                                                <ComboBoxItem Content="Verschlechtert" Tag="worse" />
                                                <ComboBoxItem Content="Unklar" Tag="unclear" />
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Text="Das Ergebnis beschreibt deine Beobachtung; zeitliche Nähe allein belegt keine Ursache." TextWrapping="Wrap" Opacity="0.75" />
                                        <TextBox x:ConnectionId='207' x:Name="MeasureReviewNote" Header="Rückblick / Beobachtungen" PlaceholderText="Was hat sich verändert? Gab es unerwünschte Effekte oder andere gleichzeitige Änderungen?"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
                                    </StackPanel>
                                    <TextBox x:ConnectionId='203' x:Name="MeasureNote" Header="Notiz zur Maßnahme" PlaceholderText="Was ist dir sonst aufgefallen?"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="100" />
                                    <TextBlock Text="Laufende Maßnahmen" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <StackPanel x:ConnectionId='204' x:Name="OngoingMeasures" Spacing="5" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:ConnectionId='197' x:Name="MeasureSaveButton" Content="Maßnahme speichern"                           Background="#167789" Foreground="White" />
                                    <Button x:ConnectionId='198' Content="Neuer Eintrag"                            />
                                    <TextBlock x:ConnectionId='199' x:Name="MeasureStatus" VerticalAlignment="Center" Foreground="#316073" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem x:ConnectionId='23' x:Name="MedicationTab" IsClosable="False">
                      <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <TextBlock x:ConnectionId='141' x:Name="MedicationTabTitle" Text="Medikamente und Supplemente" VerticalAlignment="Center" />
                          <Border x:ConnectionId='142' x:Name="MedicationDueIcon" Width="18" Height="18" CornerRadius="9" Background="#C62828" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="!" FontSize="14" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                          </Border>
                        </StackPanel>
                      </TabViewItem.Header>
                      <TabView x:ConnectionId='143' x:Name="MedicationTabs" IsAddTabButtonVisible="False" CanReorderTabs="True"
                                                                                 >
                        <TabView.Resources>
                          <SolidColorBrush x:Key="TabViewSelectionIndicatorForeground" Color="#167789" />
                          <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#20334C" />
                          <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#E2EDF3" />
                          <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#D6E7EF" />
                          <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="White" />
                          <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="White" />
                        </TabView.Resources>
                        <TabViewItem x:ConnectionId='144' x:Name="IntakeTab" IsClosable="False">
                          <TabViewItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                              <TextBlock x:ConnectionId='185' x:Name="IntakeTabTitle" Text="Tagesprotokoll" VerticalAlignment="Center" />
                              <Border x:ConnectionId='186' x:Name="IntakeDueIcon" Width="18" Height="18" CornerRadius="9" Background="#C62828" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="!" FontSize="14" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                              </Border>
                            </StackPanel>
                          </TabViewItem.Header>
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Tagesprotokoll" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8" />
                            <Grid Grid.Row="1" Margin="0,8,0,10">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                  <CalendarDatePicker x:ConnectionId='193' x:Name="IntakeDate" Header="Einnahmen am" Width="170" PlaceholderText="TT.MM.JJJJ"                                      />
                                  <ComboBox x:ConnectionId='194' x:Name="IntakeBulkTime" Header="Uhrzeit" Width="125"                                                    />
                                  <Button x:ConnectionId='195' x:Name="TakeSelectedTimeButton" Content="Eingenommen" VerticalAlignment="Bottom"
                                          IsEnabled="False"                                />
                                </StackPanel>
                                <TextBlock Text="Offen bedeutet: keine Angabe zur tatsächlichen Einnahme." />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                                <Button x:ConnectionId='191' Content="Alles genommen"                        />
                                <Button x:ConnectionId='192' Content="Alles offen"                          />
                              </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                              <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid x:ConnectionId='189' x:Name="IntakeHeader" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                  <StackPanel x:ConnectionId='190' x:Name="IntakeRows" Spacing="2" />
                                </ScrollViewer>
                              </Grid>
                            </ScrollViewer>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                              <Button x:ConnectionId='187' Content="Einnahmen für diesen Tag speichern"                           Background="#167789" Foreground="White" />
                              <TextBlock x:ConnectionId='188' x:Name="IntakeStatus" VerticalAlignment="Center" Foreground="#316073" />
                            </StackPanel>
                          </Grid>
                        </TabViewItem>
                        <TabViewItem x:ConnectionId='145' x:Name="StockTab" Header="Packungen und Vorrat" IsClosable="False">
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
