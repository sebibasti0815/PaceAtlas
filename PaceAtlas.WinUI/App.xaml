<Application
    x:Class="PaceAtlas.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="White" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPointerOver" Color="White" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelectedPressed" Color="White" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
