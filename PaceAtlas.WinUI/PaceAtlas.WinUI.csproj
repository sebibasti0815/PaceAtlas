<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release;Installer</Configurations>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaceAtlas.WinUI</RootNamespace>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Installer'">
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\PaceAtlas.Core\PaceAtlas.Core.csproj" />
    <EmbeddedResource Include="..\PaceAtlas\Resources\Pacing*.wav" LogicalName="PaceAtlas.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\PaceAtlas\app.ico" LogicalName="PaceAtlas.WinUI.app.ico" />
    <Compile Include="..\PaceAtlas\Localization.cs" Link="Shared\Localization.cs" />
    <Compile Include="..\PaceAtlas\AiConnection.cs" Link="Shared\AiConnection.cs" />
    <Content Include="Assets\flag-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\pace-atlas.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CreateInstaller" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Installer' and '$(OS)' == 'Windows_NT' and '$(IsDesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\installer\build-installer.ps1&quot;" />
  </Target>
</Project>
